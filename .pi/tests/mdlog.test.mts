import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import assert from "node:assert/strict";
const WT = new URL("../extensions", import.meta.url).pathname;
const mdLog = (await import(WT + "/md-log.ts")).default;
const handlers: Record<string, Function[]> = {};
const evs: Record<string, Function> = {};
mdLog({ on: (e: string, f: Function) => (handlers[e] ??= []).push(f), events: { on: (e: string, f: Function) => (evs[e] = f) }, registerCommand() {}, appendEntry() {} } as any);
const dir = fs.mkdtempSync(path.join(os.tmpdir(), "mdlog-"));
const file = path.join(dir, "lesson.md");
fs.writeFileSync(file, "# Lesson\n\n");
const ctx = { cwd: dir, ui: { setStatus() {}, theme: { fg: (_c: string, s: string) => s } }, sessionManager: { getEntries: () => [] } };
evs["md-log:link"]({ file, ctx });
const fire = async (e: string, ev: any) => { for (const f of handlers[e] ?? []) await f(ev, ctx); };
const body = "Why: the pool shrinks.\n\n$$\\frac{dU}{dt} = -kU$$\n\nWorked: $k = 3$.";
await fire("tool_execution_update", { toolName: "lesson_read", toolCallId: "a", partialResult: { details: { phase: "shown", title: "Slices", body, figure: "viz/decay.svg" } } });
await fire("tool_result", { toolName: "lesson_read", details: { status: "read" } });
await fire("tool_execution_update", { toolName: "recall", toolCallId: "b", partialResult: { details: { phase: "asked", kind: "predict", prompt: "If k doubles?", say: "One quick guess first.", banner: "Quick guess: one line." } } });
await fire("tool_result", { toolName: "recall", details: { status: "blocked" } });
await fire("tool_result", { toolName: "lesson_read", details: { status: "refused" } });
await fire("tool_result", { toolName: "quiz", details: { status: "unavailable", message: "Blocked: node n1 ..." } });
await new Promise((r) => setTimeout(r, 50));
const out = fs.readFileSync(file, "utf8");
console.log(out);
assert.match(out, /> \[!abstract\] PI\n\n## Reading — Slices\n\nWhy: the pool shrinks\.\n\n\$\$\\frac\{dU\}\{dt\} = -kU\$\$/, "reading is prose under a heading, not a callout");
assert.match(out, /!\[\[viz\/decay\.svg\|600\]\]/);
assert.match(out, /> \[!example\] Reading — read ✓/);
assert.match(out, /> \[!abstract\] PI\n\nOne quick guess first\.\n+> \[!question\] Recall — Predict/);
assert.match(out, /\*Quick guess: one line\.\*/);
assert.doesNotMatch(out, /unavailable|refused/i);
console.log("md-log tests ok");
